# Copy to .env.local for local overrides. Vite only exposes VITE_ prefixed vars.
#
# Leave this unset (or as below) when the SPA and the API share an origin, which
# is the case both in dev (Vite proxies /api to :8080) and in the Docker build
# (nginx proxies /api to the backend container).
VITE_API_URL=/api/v1

# Split-domain deployment instead:
# VITE_API_URL=https://api.guarantee.example.com/api/v1
