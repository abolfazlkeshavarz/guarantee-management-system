# Backend environment template. Copy to backend/.env for local development.
# The committed version of this file contained a real database password --
# rotate that credential anywhere it is still in use.

APP_ENV=development
APP_PORT=8080
APP_NAME=Evinki System

# Leave empty. Uploaded files are returned as relative /uploads/... paths so the
# same response works on localhost and in production.
APP_URL=

# ── Database ─────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=guarantee_db
DB_SSL_MODE=disable

# ── JWT ──────────────────────────────────────────────────────────────────────
# openssl rand -base64 48
# Minimum 32 characters; production boot fails on the example value.
JWT_SECRET=
JWT_EXPIRATION=24

# ── Uploads ──────────────────────────────────────────────────────────────────
UPLOAD_PATH=./uploads
MAX_UPLOAD_SIZE=10485760

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Comma-separated proxy IPs/CIDRs whose X-Forwarded-For header is trusted.
# Empty means the API is reached directly.
TRUSTED_PROXIES=
