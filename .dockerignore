# Keeping these out of the build context cuts image size and, more importantly,
# stops local .env files and uploaded customer documents from being baked in.

.git
.gitignore
.github
.claude

**/node_modules
**/dist
**/build
**/.vite
**/coverage
**/bin
**/tmp
**/logs

**/.env
**/.env.*
!**/.env.example

backend/uploads
**/*.log
**/code-summary.txt
**/*.ps1

Dockerfile*
docker-compose*.yml
README.md
DEPLOYMENT.md
