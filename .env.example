# Copy to .env next to docker-compose.yml and fill in real values.
# docker compose refuses to start if any of the required keys are missing.

# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=production
APP_NAME=Evinki System

# Where the frontend container is published. This is the whole left-hand side
# of the Docker port mapping, so it sets the bind address too.
#
# Default (unset) is 127.0.0.1:8082 - loopback only, for host nginx to proxy
# to, the same way this server already runs its other projects on 8081 and
# 8083. Pick any free loopback port; scripts/bootstrap-vps.sh picks one for you.
#   HTTP_PORT=127.0.0.1:8082     reverse-proxied by host nginx (recommended)
#   HTTP_PORT=8082               exposed directly on every interface (no proxy)
HTTP_PORT=127.0.0.1:8082

# ── Database ─────────────────────────────────────────────────────────────────
DB_USER=gms
DB_PASSWORD=CHANGE_ME_strong_database_password
DB_NAME=guarantee_db

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate with:  openssl rand -base64 48
# Must be at least 32 characters or the backend refuses to boot in production.
JWT_SECRET=BNsK2QAhrTRBcOBgPn4RMclkFTVvuipICdwB/mfGAXGHKXbnvFs4lsbR6doSRrLC

JWT_EXPIRATION=24

# ── Uploads ──────────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE=10485760

# ── CORS ─────────────────────────────────────────────────────────────────────
# Exact origins allowed to call the API, comma separated. "*" is rejected in
# production. When the SPA is served by the bundled nginx these requests are
# same-origin, so list only the public site address.
CORS_ALLOWED_ORIGINS=https://gms.evinki.com,http://gms.evinki.com

# Proxy range Gin trusts for X-Forwarded-For. The default covers the Docker
# bridge network; widen it only if you add another reverse proxy in front.
TRUSTED_PROXIES=172.16.0.0/12

# ── Frontend build ───────────────────────────────────────────────────────────
# Relative path keeps the SPA on the same origin as nginx. Change this only if
# the API is served from a different domain.
VITE_API_URL=/api/v1

# ── SMS (Melli Payamak) ──────────────────────────────────────────────────────
# false by default so a fresh checkout never sends real SMS by accident.
SMS_ENABLED=false
SMS_USERNAME=
SMS_PASSWORD=
# Where "technician requested a part" / "technician filed a report" SMS go.
SMS_ADMIN_PHONE=
# Melli Payamak's SendByBaseNumber2 sends a pre-approved template, not free
# text - each of these must be a bodyId actually registered in your Melli
# Payamak panel, shaped for that specific message. Reusing one bodyId across
# all four almost certainly sends the wrong text into the wrong placeholders.
SMS_BODY_ID_APPROVED=
SMS_BODY_ID_RENEWED=
SMS_BODY_ID_PART_REQUEST=
SMS_BODY_ID_REPAIR_REPORT=
SMS_BODY_ID_TEST=
