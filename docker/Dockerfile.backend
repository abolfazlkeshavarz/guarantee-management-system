# The previous image tag (golang:1.26.5-alpine) does not exist, so the build
# failed before it started. Pinned to a real toolchain that satisfies go.mod.
FROM golang:1.24-alpine AS builder

WORKDIR /app

RUN apk add --no-cache git ca-certificates

# Copy manifests first so dependency download is cached across code changes.
COPY backend/go.mod backend/go.sum ./
RUN go mod download

COPY backend/ .

RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/api ./cmd/api \
 && CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/migrate ./cmd/migrate

# ── Runtime ──────────────────────────────────────────────────────────────────
FROM alpine:3.20

RUN apk add --no-cache ca-certificates tzdata wget \
 && adduser -D -u 10001 gms

WORKDIR /app

COPY --from=builder /out/api /app/api
COPY --from=builder /out/migrate /app/migrate
COPY --from=builder /app/migrations /app/migrations

RUN mkdir -p /app/uploads/invoices /app/uploads/guarantee_cards \
             /app/uploads/reports /app/uploads/repair_images /app/uploads/guarantees \
 && chown -R gms:gms /app

USER gms

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://127.0.0.1:8080/health || exit 1

CMD ["/app/api"]
